 *
 * Keymap ported from kata0510/qmk_firmware
 *   branch : add_lily58_rev2
 *   path   : keyboards/lily58_rp2040/keymaps/default/keymap.c
 *
 * Layers: 0 QWERTY / 1 LOWER / 2 RAISE / 3 ADJUST
 * Only key positions and layers are ported; ZMK build config untouched.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* 0 - QWERTY  (QMK _QWERTY) */
        default_layer {
            bindings = <
&kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                                                            &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp GRAVE
&kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T                                                             &kp Y       &kp U       &kp I       &kp O       &kp P       &kp MINUS
&kp LCTRL   &kp A       &kp S       &kp D       &kp F       &kp G                                                             &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp SQT
&kp LSHIFT  &kp Z       &kp X       &kp C       &kp V       &kp B   &kp LBKT    &kp RBKT    &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp RSHIFT
                                    &mo 1       &kp LGUI    &kp LALT    &lt 1 SPACE                 &lt 2 ENTER &kp BACKSPACE  &kp RGUI    &mo 2
            >;
        };

        /* 1 - LOWER  (QMK _LOWER) */
        lower_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EXCL &kp AT &kp POUND &kp DLLR &kp PRCNT                                        &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &trans
&trans  &kp N1   &kp N2  &kp N3   &kp N4   &kp N5                                            &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PIPE &kp GRAVE &kp PLUS &kp LBRC &kp RBRC &trans
                                 &trans  &trans  &trans  &trans                 &trans  &trans  &trans  &trans
            >;
        };

        /* 2 - RAISE  (QMK _RAISE) */
        raise_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                              &trans  &trans  &trans  &trans  &trans  &trans
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                                               &kp F7  &kp F8  &kp F9  &kp F10 &kp F11 &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                                              &none   &kp LEFT &kp DOWN &kp UP  &kp RIGHT &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PLUS &kp EQUAL &kp LBKT &kp RBKT &kp BACKSLASH &trans
                                 &trans  &trans  &trans  &trans                 &trans  &trans  &trans  &trans
            >;
        };

        /* 3 - ADJUST  (QMK _ADJUST: XXXXXXX = &none, _______ = &trans) */
        adjust_layer {
            bindings = <
&none  &none  &none  &none  &none  &none                                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                                &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
                              &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans
            >;
        };
    };
};
